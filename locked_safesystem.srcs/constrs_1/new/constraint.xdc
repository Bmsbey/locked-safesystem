set_property PACKAGE_PIN T2  [get_ports {digit2[2]}]
set_property PACKAGE_PIN R3  [get_ports {digit2[3]}]
set_property IOSTANDARD LVCMOS33 [get_ports {digit2[*]}]
set_property PACKAGE_PIN A14 [get_ports {match_leds[0]}]
set_property PACKAGE_PIN A16 [get_ports {match_leds[1]}]
set_property PACKAGE_PIN B15 [get_ports {match_leds[2]}]
set_property IOSTANDARD LVCMOS33 [get_ports {match_leds[*]}]
set_property PACKAGE_PIN K17 [get_ports green_led]
set_property PACKAGE_PIN M18 [get_ports yellow_led]
set_property PACKAGE_PIN N17 [get_ports red_led]
set_property IOSTANDARD LVCMOS33 [get_ports {green_led yellow_led red_led}]
set_property PACKAGE_PIN B16 [get_ports system_status_led]
set_property IOSTANDARD LVCMOS33 [get_ports system_status_led]
set_property PACKAGE_PIN J1 [get_ports buzzer_short]
set_property PACKAGE_PIN L2 [get_ports buzzer_long]
set_property IOSTANDARD LVCMOS33 [get_ports {buzzer_short buzzer_long}]
set_property PACKAGE_PIN H1 [get_ports servo_pwm]
set_property IOSTANDARD LVCMOS33 [get_ports servo_pwm]
